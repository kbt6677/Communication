[-----------------------------------------------------------------------------]
[     PATHWAY CONFIGURATION FOR JCB SYSTEM  JCN-POS ( IT3　Visa環境 )                ]
[-----------------------------------------------------------------------------]
[ ** PATHWAY-INFO ** ]

SET   PATHMON        BACKUPCPU          6
SET   PATHWAY        MAXASSIGNS         1500
SET   PATHWAY        MAXPARAMS          2000
SET   PATHWAY        MAXSERVERCLASSES   200
SET   PATHWAY        MAXSERVERPROCESSES 6500
SET   PATHWAY        MAXSTARTUPS        100
SET   PATHWAY        MAXTCPS            10
SET   PATHWAY        MAXTERMS           100
SET   PATHWAY        MAXPATHCOMS        10
SET   PATHWAY        MAXPROGRAMS        5
SET   PATHWAY        MAXTELLQUEUE       4
SET   PATHWAY        MAXTELLS           32
SET   PATHWAY        MAXTMFRESTARTS     5
SET   PATHWAY        MAXLINKMONS        128
SET   PATHWAY        MAXDEFINES         8191
SET   PATHWAY        SECURITY           "N"
START PATHWAY COLD!

ERRORS 1

LOG1 $0,EVENTFORMAT,STATUS
LOG2 $GFPW01.IGFPN.UBX1PLG

ERRORS 0

[** BOXCAR振り分けサーバ-P **]
RESET SERVER
SET   SERVER (assign ALTRC,$GFPD07.AGFPD.ALTRC,shared)
SET   SERVER PARAM       PM-TRACE-FLG       "00"
SET   SERVER PARAM       PM-MY-SERVERCLASS-NAME "SRV-BCRFS010"
SET   SERVER DEFINE =BCTLI0         ,FILE $GFPL01.BBXCD.BCTLI0
SET   SERVER DEFINE =BSTAT0         ,FILE $GFPD06.ABXCD.BSTAT0
SET   SERVER DEFINE =MESSAGE_FILE   ,FILE $GFPL01.ABXCD.MEMSM0
SET   SERVER DEFINE =COLLECTOR      ,FILE $0
SET   SERVER PARAM       REPLY-TIMER        "000050"
SET   SERVER PARAM       THREAD-CNT         "64"
SET   SERVER PARAM       OPEN-CNT           "5"
SET   SERVER PARAM       LOG-LEVEL          "0"
SET   SERVER PARAM       SAVE-ENVIRONMENT   "ON"
SET   SERVER AUTORESTART 8
SET   SERVER HOMETERM    $ZHOME
SET   SERVER PRI         165
SET   SERVER PROGRAM     $JCBL01.ABXCL.BCRFS010
SET   SERVER DEBUG       OFF
SET   SERVER CREATEDELAY 1  SECS
SET   SERVER DELETEDELAY 10 MINS
SET   SERVER LINKDEPTH   1
SET   SERVER MAXLINKS    8
SET   SERVER MAXSERVERS  8
SET   SERVER NUMSTATIC   8
SET   SERVER TMF         ON
SET   SERVER HIGHPIN     ON
SET   SERVER PROCESS     $E1AA1 (CPUS 2:3)
SET   SERVER PROCESS     $E1AA2 (CPUS 3:4)
SET   SERVER PROCESS     $E1AA3 (CPUS 4:5)
SET   SERVER PROCESS     $E1AA4 (CPUS 5:6)
SET   SERVER PROCESS     $E1AA5 (CPUS 6:7)
SET   SERVER PROCESS     $E1AA6 (CPUS 7:0)
SET   SERVER PROCESS     $E1AA7 (CPUS 0:1)
SET   SERVER PROCESS     $E1AA0 (CPUS 1:2)
ADD   SERVER SRV-BCRFS010

